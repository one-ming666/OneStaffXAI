# OneStaff X AI configuration template, 2026-09-19. No real credentials.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Set production, PUBLIC_URL and TRUST_PROXY behind your HTTPS reverse proxy.
# PUBLIC_URL=https://your-domain.example
# TRUST_PROXY=1
# ADMIN_PASSWORD=
# MCP_TOKEN=
# OPENHEX_BASE_URL=https://api.openhex.tech
# OPENHEX_AUTH_MODE=personal
# OPENHEX_API_KEY=
# Optional workspace authentication requires a workspace-specific key.
# OPENHEX_WORKSPACE_SLUG=
# OPENHEX_WORKSPACE_KEY=
# DATA_DIR=./data
# Optional override for the bundled PDF font:
# PDF_FONT=
